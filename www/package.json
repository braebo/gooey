{
	"name": "gooey-www",
	"version": "0.0.1",
	"private": true,
	"description": "Website for [gooey](https://github.com/braebo/gooey).",
	"keywords": [
		"sveltekit",
		"template",
		"starter",
		"svelte",
		"kit"
	],
	"type": "module",
	"scripts": {
		"build": "vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --compiler-warnings 'element_invalid_self_closing_tag:ignore'",
		"check:watch": "svelte-kit sync && svelte-check --watch --tsconfig ./tsconfig.json --compiler-warnings 'element_invalid_self_closing_tag:ignore'",
		"dev": "vite dev",
		"extras": "pnpm i -D type-fest froebel nanostores rxjs",
		"format": "prettier --write --plugin-search-dir=. .",
		"postinstall": "svelte-kit sync",
		"lint": "prettier --check . --plugin-search-dir .",
		"preview": "vite preview",
		"test": "playwright test",
		"test:unit": "vitest"
	},
	"devDependencies": {
		"@playwright/test": "^1.47.2",
		"@samplekit/preprocess-shiki": "link:../../../../samplekit/packages/preprocess-shiki",
		"@shikijs/core": "^1.18.0",
		"@shikijs/transformers": "^1.18.0",
		"@shikijs/twoslash": "^1.18.0",
		"@sveltejs/adapter-auto": "^3.2.5",
		"@sveltejs/adapter-static": "^3.0.5",
		"@sveltejs/kit": "^2.5.28",
		"@sveltejs/vite-plugin-svelte": "^4.0.0-next.6",
		"@types/cookie": "^0.6.0",
		"@types/hast": "^3.0.4",
		"@types/node": "^22.6.1",
		"@vitest/ui": "^2.1.1",
		"autoprefixer": "^10.4.20",
		"cookie": "^0.6.0",
		"cssnano": "^7.0.6",
		"esm-env": "^1.0.0",
		"fractils": "^3.1.3",
		"greset": "^2.0.0",
		"hast-util-raw": "^9.0.4",
		"hast-util-select": "^6.0.2",
		"hast-util-to-text": "^4.0.2",
		"magic-string": "^0.30.11",
		"mdsvex": "^0.12.3",
		"pixi.js": "^8.4.1",
		"postcss": "^8.4.47",
		"postcss-load-config": "^6.0.1",
		"prettier": "^3.3.3",
		"prettier-plugin-svelte": "^3.2.6",
		"pug": "^3.0.3",
		"rehype": "^13.0.1",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-slug": "^6.0.0",
		"rehype-stringify": "^10.0.0",
		"remark-abbr": "^1.4.2",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.1",
		"runed": "^0.15.2",
		"sass": "^1.79.3",
		"shiki": "^1.18.0",
		"svelte": "5.0.0-next.258",
		"svelte-awesome-pug": "^0.1.3",
		"svelte-check": "^4.0.2",
		"svelte-preprocess": "^6.0.2",
		"sveltekit-view-transition": "^0.5.3",
		"tslib": "^2.7.0",
		"typescript": "^5.6.2",
		"unified": "^11.0.5",
		"unist-util-modify-children": "^4.0.0",
		"vite": "^5.4.7",
		"vitest": "^2.1.1"
	}
}
