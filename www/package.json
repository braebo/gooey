{
	"name": "gooey-www",
	"version": "0.0.1",
	"private": true,
	"description": "Website for [gooey](https://github.com/braebo/gooey).",
	"keywords": [
		"sveltekit",
		"template",
		"starter",
		"svelte",
		"kit"
	],
	"type": "module",
	"scripts": {
		"build": "vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --compiler-warnings 'element_invalid_self_closing_tag:ignore'",
		"check:watch": "svelte-kit sync && svelte-check --watch --tsconfig ./tsconfig.json --compiler-warnings 'element_invalid_self_closing_tag:ignore'",
		"dev": "vite dev",
		"extras": "pnpm i -D type-fest froebel nanostores rxjs",
		"format": "prettier --write --plugin-search-dir=. .",
		"postinstall": "svelte-kit sync",
		"lint": "prettier --check . --plugin-search-dir .",
		"preview": "vite preview",
		"test": "playwright test",
		"test:unit": "vitest"
	},
	"devDependencies": {
		"@playwright/test": "^1.55.1",
		"@samplekit/preprocess-shiki": "^3.0.0",
		"@shikijs/core": "^3.13.0",
		"@shikijs/transformers": "^3.13.0",
		"@shikijs/twoslash": "^3.13.0",
		"@sveltejs/adapter-auto": "^6.1.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.43.7",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@types/cookie": "^1.0.0",
		"@types/hast": "^3.0.4",
		"@types/node": "^24.6.2",
		"@vitest/ui": "^3.2.4",
		"autoprefixer": "^10.4.21",
		"cookie": "^1.0.2",
		"cssnano": "^7.1.1",
		"esm-env": "^1.2.2",
		"fractils": "^3.1.3",
		"greset": "^2.0.0",
		"hast-util-raw": "^9.1.0",
		"hast-util-select": "^6.0.4",
		"hast-util-to-text": "^4.0.2",
		"magic-string": "^0.30.19",
		"mdsvex": "^0.12.6",
		"pixi.js": "^8.13.2",
		"postcss": "^8.5.6",
		"postcss-load-config": "^6.0.1",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"pug": "^3.0.3",
		"rehype": "^13.0.2",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-slug": "^6.0.0",
		"rehype-stringify": "^10.0.1",
		"remark-abbr": "^1.4.2",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"runed": "^0.34.0",
		"sass": "^1.93.2",
		"shiki": "^3.13.0",
		"svelte": "5.39.8",
		"svelte-awesome-pug": "^0.1.3",
		"svelte-check": "^4.3.2",
		"svelte-preprocess": "^6.0.3",
		"sveltekit-view-transition": "^0.5.3",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3",
		"unified": "^11.0.5",
		"unist-util-modify-children": "^4.0.0",
		"vite": "^7.1.9",
		"vitest": "^3.2.4"
	}
}
