{
	"name": "gooey",
	"version": "0.3.2",
	"description": "A modern gui library for the web.",
	"keywords": [
		"gui",
		"typescript",
		"javascript"
	],
	"homepage": "https://gooey.braebo.dev",
	"license": "MIT",
	"author": "braebo",
	"type": "module",
	"exports": {
		".": {
			"development": "./src/index.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsdown",
		"build:watch": "tsdown --watch ./src",
		"build:all": "bun run build && bun run build:www",
		"build:www": "cd www && bun i && bun run build",
		"check": "tsc --noEmit",
		"check:all": "bun check && bun check:www",
		"check:www": "cd www && bun check",
		"check:watch": "tsc --noEmit --watch",
		"dev": "cd www && bun dev",
		"dev:www": "cd www && bun dev",
		"docinate": "bun run ../docinator/src/docinator.ts ./docs/extracted ./docs/highlighted",
		"docinate:watch": "bun run --watch ../docinator/src/docinator.ts ./docs/extracted ./src/docs/highlighted",
		"extract": "bun extractinator extract src docs/extracted --quiet=false",
		"format": "prettier --write src",
		"lint": "publint && prettier --check src",
		"sort": "bunx sort-package-json && cd www && pnpm dlx sort-package-json",
		"sync-version": "changeset version && pnpx sync-version jsr.json",
		"test": "bun vitest --run --browser.headless",
		"test:ui": "bun vitest --run",
		"test:watch": "bun vitest --browser.headless",
		"test:watch:ui": "bun vitest"
	},
	"dependencies": {
		"esm-env": "^1.2.2"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "^0.18.2",
		"@braebo/ansi": "^0.2.0",
		"@braebo/docinator": "link:@braebo/docinator",
		"@changesets/cli": "2.29.7",
		"@fontsource-variable/fredoka": "^5.2.10",
		"@rollup/plugin-node-resolve": "16.0.1",
		"@rollup/plugin-typescript": "12.1.4",
		"@svitejs/changesets-changelog-github-compact": "1.2.0",
		"@swc/core": "1.13.5",
		"@types/bun": "^1.2.22",
		"@types/node": "24.5.2",
		"@vitest/browser": "^3.2.4",
		"@vitest/ui": "^3.2.4",
		"changeset": "0.2.6",
		"csstype": "3.1.3",
		"esbuild": "0.25.10",
		"extractinator": "link:extractinator",
		"jsr-exports-lint": "^0.4.1",
		"nodemon": "^3.1.10",
		"ora": "9.0.0",
		"picocolors": "1.1.1",
		"pocket-shader": "^0.3.1",
		"prettier": "3.6.2",
		"publint": "0.3.13",
		"rolldown": "^1.0.0-beta.40",
		"rolldown-plugin-dts": "^0.16.9",
		"rollup": "4.52.2",
		"rollup-plugin-rename-node-modules": "^1.3.1",
		"sass": "^1.93.2",
		"tsdown": "^0.15.5",
		"tslib": "2.8.1",
		"typescript": "^5.9.2",
		"vite-node": "3.2.4",
		"vitest": "^3.2.4",
		"webdriverio": "^9.19.2"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.js",
			"./package.json": "./package.json"
		}
	}
}
