{
	"svelte.plugin.svelte.compilerWarnings": {
		"element_invalid_self_closing_tag": "ignore"
	},
	"editor.formatOnSave": false,
	"files.associations": {
		"[*.md, *.svx, *.mdsvex]": "mdx", //* https://github.com/pngwn/MDsveX/issues/121#issuecomment-675106929
		"*.xml": "html", //* Prettier
		"*.svg": "html" //* Prettier
	},

	"[typescript, javascript, html]": {
		"editor.formatOnSave": false,
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},

	"[svelte]": {
		"editor.defaultFormatter": "svelte.svelte-vscode"
	},

	"svelte.enable-ts-plugin": true,
	"svelte.plugin.css.globals": "src/styles/theme.scss, src/styles/app.scss",

	"workbench.iconTheme": "material-icon-theme",

	"workbench.editor.labelFormat": "short",

	//* File nesting.
	"explorer.fileNesting.expand": false,
	"explorer.fileNesting.patterns": {
		".gitignore": ".gitattributes, .gitmodules, .gitmessage, .mailmap, .git-blame*",
		"*.js": "$(capture).min.js, $(capture).d.ts, $(capture).js.map, $(capture).d.ts.map",
		"*.ts": "$(capture).js, $(capture).test.ts, $(capture).spec.ts, $(capture).d.ts, $(capture).d.ts.map, $(capture).md",
		"*.svelte": "$(capture).js, $(capture).ts, $(capture).*.ts",
		"dockerfile": ".dockerignore, dockerfile*",
		"package.json": "bun.lock, deno.lock, .gitignore",
		"readme.*": "authors, backers.md, changelog*, citation*, code_of_conduct.md, codeowners, contributing.md, contributors, copying, credits, governance.md, history.md, license*, maintainers, readme*, security.md, sponsors.md",
		"svelte.config.*": "*.env, .eslint*, .babelrc*, .codecov, .cssnanorc*, .env.*, .htmlnanorc*, .mocha*, .postcssrc*, .terserrc*, api-extractor.json, ava.config.*, babel.config.*, cssnano.config.*, cypress.json, env.d.ts, htmlnanorc.*, jasmine.*, jest.config.*, jsconfig.*, karma*,.prettier*, mdsvex.config.js, playwright.config.*, postcss.config.*, puppeteer.config.*, svgo.config.*, tailwind.config.*, tsdoc.*, unocss.config.*, vercel*, vite.config.*, vitest.config.*, webpack.config.*, windi.config.*",
		"favicon.ico": "robots.txt, safari-pinned-tab.svg, browserconfig.xml, site.webmanifest, *.png",
		".prettierrc": ".prettierignore",
		"vitest.config.ts": "vitest.shims.d.ts"
	},

	//* More comment tags.
	"better-comments.tags": [
		{
			"tag": "·",
			"color": "#374fa6",
			"bold": true
		},
		{
			"tag": "⌟",
			"color": "#002255",
			"bold": true
		},
		{
			"tag": "!",
			"color": "#886f50",
			"strikethrough": false,
			"underline": false,
			"backgroundColor": "transparent",
			"bold": false,
			"italic": false
		},
		{
			"tag": "?",
			"color": "#3498DB",
			"strikethrough": false,
			"underline": false,
			"backgroundColor": "transparent",
			"bold": false,
			"italic": false
		},
		{
			"tag": "//",
			"color": "#474747",
			"strikethrough": true,
			"underline": false,
			"backgroundColor": "transparent",
			"bold": false,
			"italic": false
		},
		{
			"tag": "todo",
			"color": "#FF8C00",
			"strikethrough": false,
			"underline": false,
			"backgroundColor": "transparent",
			"bold": false,
			"italic": false
		},
		{
			"tag": "*",
			"color": "#98C379",
			"strikethrough": false,
			"underline": false,
			"backgroundColor": "transparent",
			"bold": false,
			"italic": false
		}
	],

	"editor.tokenColorCustomizations": {
		"textMateRules": [
			//* More subtle samplekit shiki pp tags.
			{
				"scope": ["keyword.control.svelte", "!text.svelte", "!source.svelte"],
				"settings": {
					// "foreground": "#FF00FF"
					"foreground": "#5a86ff36"
				}
			},
			//* More subtle Template Tags.
			{
				"scope": [
					"punctuation.definition.tag",
					"entity.name.tag.svelte",
					"punctuation.separator.key-value.svelte",
					"constant.name.attribute.tag.pug"
				],
				"settings": {
					"foreground": "#5a86ff36"
				}
			}
